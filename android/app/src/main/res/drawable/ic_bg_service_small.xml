<?xml version="1.0" encoding="utf-8"?>
<!-- Required by flutter_background_service's native BackgroundService.java,
     which hardcodes R.drawable.ic_bg_service_small as the persistent
     foreground-service notification's small icon — without this exact
     resource name present, Android rejects the notification entirely
     with "Bad notification for startForeground" and the app crashes.
     Simple filled-circle silhouette, per Android's status-bar-icon
     convention (single shape, no gradients/detail — the OS re-tints it). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z"/>
</vector>
